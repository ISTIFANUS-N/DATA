PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
PUBLIC_MONNIFY_API_KEY=MK_TEST_...
PUBLIC_MONNIFY_CONTRACT_CODE=...
# Server-only. Never prefix with PUBLIC_.
MONNIFY_SECRET_KEY=...
# Sandbox: https://sandbox.monnify.com   Live (default): https://api.monnify.com
MONNIFY_BASE_URL=https://api.monnify.com

# Which API serves each service (vtpass | mock). Unset = service shows "unavailable".
PROVIDER_AIRTIME=vtpass
PROVIDER_DATA=vtpass
# VTpass: sandbox https://sandbox.vtpass.com/api, live https://vtpass.com/api
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=...
VTPASS_SECRET_KEY=...
# Testing only: allow PROVIDER_*=mock outside local dev
# ALLOW_MOCK_PROVIDER=true
